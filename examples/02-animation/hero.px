# The SNES-scale hero: an idle (first frame held longer) and an 8-frame walk.
# pivot=12,31 is the pixel under his feet: anim and onion line frames up on it.
pxart 1
@palette hero-palette.px

@anim idle/down ms=220 pivot=12,31
@anim walk/down ms=110 pivot=12,31

@frame idle/down/0 ms=360
