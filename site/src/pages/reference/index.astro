---
import Docs from "../../layouts/Docs.astro";
import { ref, TOPIC_ORDER, TOPIC_BLURB } from "../../lib/content";
import { referenceNav } from "../../lib/nav";
import { helpHtml } from "../../lib/helptext";
const groups = TOPIC_ORDER.map((t) => ({ topic: t, commands: ref.commands.filter((c) => c.topic === t) }));
const headings = groups.map((g) => ({ depth: 2, id: g.topic.toLowerCase(), text: g.topic.charAt(0) + g.topic.slice(1).toLowerCase() }));
---
<Docs title="Command reference" eyebrow={`pxart ${ref.version}`} section="reference" nav={referenceNav()} headings={[{ depth: 2, id: "overview", text: "pxart -h" }, ...headings]} source="site/src/data/reference.json"
  lead="Every command's own help, as pxart prints it. Each page here is the output of pxart help CMD, so the site and the tool say the same thing.">
  {groups.map((g) => (
    <section>
      <div class="topic-head" id={g.topic.toLowerCase()}>
        <h2>{g.topic.charAt(0) + g.topic.slice(1).toLowerCase()}</h2>
        <p>{TOPIC_BLURB[g.topic]}</p>
        <a href={`/reference/topics/${g.topic.toLowerCase()}/`}>pxart help {g.topic} →</a>
      </div>
      <div class="cmd-grid">
        {g.commands.map((c) => (
          <a class="cmd-card" href={`/reference/${c.name}/`}>
            <code>{c.name}</code>
            <p>{c.summary}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  <div class="topic-head" id="overview"><h2>pxart -h</h2><p>The short overview: the format in a few lines, and the commands by topic.</p></div>
  <pre class="help" style="margin-top:1rem"><code set:html={helpHtml(ref.overview)} /></pre>
</Docs>
