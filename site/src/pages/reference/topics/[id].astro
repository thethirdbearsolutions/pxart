---
import Docs from "../../../layouts/Docs.astro";
import { ref } from "../../../lib/content";
import { referenceNav } from "../../../lib/nav";
import { helpHtml } from "../../../lib/helptext";

export function getStaticPaths() {
  return ref.topics.map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props;
const LEADS: Record<string, string> = {
  recipes: "Seven workflows, end to end, command by command.",
  worlds: "Compile a world of .map rooms into Tiled's .world and .tmj files.",
  slots: "A key's alternative colors, for a game that recolors sprites at runtime.",
};
---
<Docs title={t.title} eyebrow={`pxart help ${LEADS[t.id] ? t.id : t.id.toUpperCase()}`} section="reference" nav={referenceNav()} lead={LEADS[t.id]} source="site/src/data/reference.json">
  <pre class="help"><code set:html={helpHtml(t.text)} /></pre>
</Docs>
