---
import Base from "../../layouts/Base.astro";
import { posts, HUBS, readingMinutes } from "../../lib/blog";

export async function getStaticPaths() {
  const all = await posts();
  return all.map((p) => ({ params: { slug: p.slug }, props: { p, all } }));
}
const { p, all } = Astro.props;
const hub = HUBS[p.hub];
const related = p.related.map((s) => all.find((x) => x.slug === s)!).filter(Boolean);
const url = new URL(`/blog/${p.slug}/`, Astro.site).href;
const og = p.heroSprite ? `/blog/${p.slug}/og.png` : undefined;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: p.title,
    description: p.description,
    datePublished: p.date,
    dateModified: p.updated ?? p.date,
    author: { "@type": "Organization", name: p.byline.replace(/^Written by /, "") },
    publisher: { "@type": "Organization", name: "Third Bear Solutions", url: "https://thirdbearsolutions.com" },
    mainEntityOfPage: url,
    ...(og ? { image: new URL(og, Astro.site).href } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Blog", item: new URL("/blog/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: hub.title, item: new URL(`/blog/hub/${p.hub}/`, Astro.site).href },
      { "@type": "ListItem", position: 3, name: p.title, item: url },
    ],
  },
];
---
<Base title={p.title} description={p.description} section="blog" ogType="article" ogImage={og} jsonLd={jsonLd}>
  <article class="wrap blog-wrap">
    <header class="page-head">
      <div class="eyebrow"><a href="/blog/">Blog</a> · <a href={`/blog/hub/${p.hub}/`}>{hub.title}</a>{p.draft && " · DRAFT"}</div>
      <h1>{p.title}</h1>
      <p class="lead">{p.description}</p>
      <p class="post-meta">{p.byline} · <time datetime={p.date}>{p.date}</time>{p.updated && <> · updated <time datetime={p.updated}>{p.updated}</time></>} · {readingMinutes(p.words)} min read</p>
    </header>
    <div class="prose" set:html={p.html} />
    <footer class="post-foot">
      {p.credits && <p><strong>Who drew what:</strong> {p.credits}</p>}
      <p>{p.footer}</p>
    </footer>
    {related.length > 0 && (
      <nav class="keep-going" aria-label="Keep going">
        <h2>Keep going</h2>
        <div class="cmd-grid">
          {related.map((r) => <a class="cmd-card" href={`/blog/${r.slug}/`}><code>{HUBS[r.hub].title}</code><p><strong>{r.title}</strong><br />{r.description}</p></a>)}
        </div>
      </nav>
    )}
  </article>
</Base>
<script>
  // the try-me editors that ```tryme blocks put on a post
  if (document.querySelector(".pg[data-samples]")) import("../../scripts/playground");
</script>
