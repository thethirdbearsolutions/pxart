---
import Docs from "../../layouts/Docs.astro";
import { tutorials, tutorialsIndex } from "../../lib/content";
import { tutorialsNav } from "../../lib/nav";
import { renderMarkdown } from "../../lib/markdown";

const ts = await tutorials();
const intro = await tutorialsIndex();
const nav = await tutorialsNav();
const uses = await Promise.all(ts.map(async (t) => (await renderMarkdown(t.uses)).html.replace(/^<p>|<\/p>\s*$/g, "")));
---
<Docs title="Tutorials" eyebrow="Learn by making" section="tutorials" nav={nav} headings={intro.headings} source="examples/README.md" lead={intro.lead} next={{ href: `/tutorials/${ts[0].slug}/`, label: `${ts[0].number} · ${ts[0].short}` }}>
  <div class="tut-grid">
    {ts.map((t, i) => (
      <a class="tut-card" href={`/tutorials/${t.slug}/`}>
        <div class="thumb">{t.thumb && <img src={t.thumb} alt="" loading={i < 3 ? "eager" : "lazy"} />}</div>
        <div class="body">
          <div class="n">{t.number}</div>
          <h3>{t.short}</h3>
          <p set:html={uses[i]} />
        </div>
      </a>
    ))}
  </div>
  <div class="prose" set:html={intro.html.replace(/^\s*<p>[\s\S]*?<\/p>/, "")} />
</Docs>
