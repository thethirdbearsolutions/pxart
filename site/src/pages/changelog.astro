---
import Docs from "../layouts/Docs.astro";
import { changelog } from "../lib/content";
import { docsNav } from "../lib/nav";
const c = await changelog();
const nav = await docsNav();
---
<Docs title="Changelog" eyebrow="What's new" section="changelog" nav={nav} headings={c.headings.filter((h) => h.depth === 2)} source="CHANGELOG.md" description="What changed in pxart, newest first.">
  <div class="prose changelog" set:html={c.html} />
</Docs>
