---
import Base from "../layouts/Base.astro";
---
<Base title="Not found">
  <div class="wrap" style="padding:5rem 1rem;max-width:44rem">
    <div class="code-block" data-lang="output"><pre class="plain"><code>pxart: E_SELECT: no page here
  try the docs, the tutorials or the reference</code></pre></div>
    <h1 style="font-size:3rem;margin:2rem 0 1rem">404</h1>
    <p>That page isn't here. It may have moved when the docs were rebuilt.</p>
    <p style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem">
      <a class="btn primary" href="/docs/">Docs</a>
      <a class="btn" href="/tutorials/">Tutorials</a>
      <a class="btn" href="/reference/">Reference</a>
    </p>
  </div>
</Base>
