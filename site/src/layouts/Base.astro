---
import "@fontsource/pixelify-sans/500.css";
import "@fontsource/pixelify-sans/600.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { GITHUB } from "../lib/paths";
import { ref } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  section?: "home" | "docs" | "tutorials" | "reference" | "changelog";
}
const { title, description = "Pixel art as text. A sprite is a small plain-text file that renders to PNG: language models can write it, git can diff it, and you can read it.", section } = Astro.props;
const fullTitle = title ? `${title} · pxart` : "pxart: pixel art as text";
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: "/docs/", label: "Docs", id: "docs" },
  { href: "/tutorials/", label: "Tutorials", id: "tutorials" },
  { href: "/reference/", label: "Reference", id: "reference" },
  { href: "/changelog/", label: "Changelog", id: "changelog" },
];
const footStrip = ["#2b1e2f", "#5e3a2a", "#9b6440", "#de8a3c", "#f3cf6b", "#efe6d2", "#a6dce4", "#3f7fa8", "#26496e", "#37487a", "#4f8c6c", "#c4473a", "#d8718c"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#efe6d2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1326" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const t = localStorage.getItem("pxart-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/" aria-label="pxart home">
          <Logo />
          <span>pxart</span>
          <span class="ver" title="version">{ref.version}</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">menu</button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={section === n.id ? "page" : undefined}>{n.label}</a>)}
          <a href={GITHUB}>GitHub</a>
          <button class="theme-toggle" type="button" aria-label="Switch between day and dusk colors"><span class="theme-label">%day</span></button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <div class="about">
          <div class="strip" aria-hidden="true">{footStrip.map((c) => <span style={`--c:${c}`} />)}</div>
          <p>
            pxart is free software under the MIT license, made by{" "}
            <a href="https://thirdbearsolutions.com">Third Bear Solutions</a>. The art in the
            tutorials comes from our own packs and is released with the repository.
          </p>
        </div>
        <div>
          <h2>Learn</h2>
          <ul>
            <li><a href="/docs/">Getting started</a></li>
            <li><a href="/docs/format/">The .px format</a></li>
            <li><a href="/tutorials/">Tutorials</a></li>
          </ul>
        </div>
        <div>
          <h2>Look up</h2>
          <ul>
            <li><a href="/reference/">Command reference</a></li>
            <li><a href="/docs/errors/">Error codes</a></li>
            <li><a href="/changelog/">Changelog</a></li>
          </ul>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li><a href={GITHUB}>Source on GitHub</a></li>
            <li><a href={`${GITHUB}/issues`}>Issues</a></li>
            <li><a href={`${GITHUB}/blob/main/LICENSE`}>MIT license</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const label = document.querySelector<HTMLElement>(".theme-label");
      const isDark = () => root.dataset.theme === "dark" || (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
      const show = () => label && (label.textContent = isDark() ? "%dusk" : "%day");
      show();
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", show);
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("pxart-theme", next);
        } catch {}
        show();
      });

      const header = document.querySelector<HTMLElement>(".site-header");
      const menu = document.querySelector<HTMLButtonElement>(".menu-toggle");
      menu?.addEventListener("click", () => {
        const open = header!.toggleAttribute("data-open");
        menu.setAttribute("aria-expanded", String(open));
      });

      for (const block of document.querySelectorAll<HTMLElement>(".code-block[data-lang='sh']")) {
        const btn = document.createElement("button");
        btn.className = "copy";
        btn.type = "button";
        btn.textContent = "copy";
        btn.addEventListener("click", async () => {
          const text = block.querySelector("pre")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = "copied";
          } catch {
            btn.textContent = "select it";
          }
          setTimeout(() => (btn.textContent = "copy"), 1500);
        });
        block.append(btn);
      }
    </script>
  </body>
</html>
