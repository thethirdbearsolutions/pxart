---
import Base from "./Base.astro";
import type { Heading } from "../lib/markdown";
import { GITHUB_BLOB } from "../lib/paths";

export interface NavItem {
  href: string;
  label: string;
  num?: string;
  code?: boolean;
}
export interface NavGroup {
  title: string;
  items: NavItem[];
}
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  description?: string;
  section: "docs" | "tutorials" | "reference" | "changelog";
  nav: NavGroup[];
  headings?: { depth: number; id: string; text: string }[];
  source?: string;
  prev?: NavItem | null;
  next?: NavItem | null;
}
const { title, eyebrow, lead, description, section, nav, headings = [], source, prev, next } = Astro.props;
const here = Astro.url.pathname;
const toc = headings.filter((h: Heading) => h.depth === 2 || h.depth === 3);
---
<Base title={title} description={description ?? lead} section={section}>
  <div class:list={["docs", { "no-toc": toc.length < 2 }]}>
    <aside class="sidebar" aria-label="Section">
      {nav.map((g) => (
        <>
          <h2>{g.title}</h2>
          <ul>
            {g.items.map((i) => (
              <li>
                <a href={i.href} aria-current={i.href === here ? "page" : undefined}>
                  {i.num && <span class="num">{i.num}</span>}
                  {i.code ? <code>{i.label}</code> : i.label}
                </a>
              </li>
            ))}
          </ul>
        </>
      ))}
    </aside>
    <article class="content">
      <nav class="mobile-nav" aria-label="Section">
        <label class="visually-hidden" for="mobile-nav-select">Go to page</label>
        <select id="mobile-nav-select" onchange="location.href=this.value">
          {nav.map((g) => (
            <optgroup label={g.title}>
              {g.items.map((i) => <option value={i.href} selected={i.href === here}>{i.num ? `${i.num} · ` : ""}{i.label}</option>)}
            </optgroup>
          ))}
        </select>
      </nav>
      <header class="page-head">
        {eyebrow && <div class="eyebrow">{eyebrow}</div>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </header>
      <slot />
      {(prev || next) && (
        <nav class="pager" aria-label="Pages">
          {prev && <a class="prev" href={prev.href}><small>← Previous</small><strong>{prev.label}</strong></a>}
          {next && <a class="next" href={next.href}><small>Next →</small><strong>{next.label}</strong></a>}
        </nav>
      )}
      {source && (
        <div class="page-foot">
          <span>This page is built from <a href={GITHUB_BLOB + source}><code>{source}</code></a> in the repository.</span>
          <a href={GITHUB_BLOB + source}>Edit on GitHub</a>
        </div>
      )}
    </article>
    {toc.length >= 2 && (
      <nav class="toc" aria-label="On this page">
        <h2>On this page</h2>
        <ul>
          {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.id}`}>{h.text}</a></li>)}
        </ul>
      </nav>
    )}
  </div>
</Base>
