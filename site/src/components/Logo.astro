---
// The README's small face, as the site's mark: drawn from its own .px source.
import { parsePx, frameSvg } from "../lib/px";
const FACE = `k #3f2631
g #43e1b3
y #fee761

....kkkk....
...kggggk...
..kgyggygk..
...kggggk...
....kkkk....`;
const doc = parsePx(FACE);
const svg = frameSvg(doc.frames[0], doc.palette, { cls: "px-svg logo-svg" });
---
<Fragment set:html={svg} />
