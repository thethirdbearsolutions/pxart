---
// Type .px, see pixels. A small editor over a painted copy of the text, and a canvas
// that draws (and plays) what's typed. It is a sketchpad, not pxart: the tool checks
// far more than this does.
import samples from "../data/playground.json";
const first = samples[0];
---
<div class="pg" data-samples={JSON.stringify(samples)}>
  <div class="pg-bar">
    <span class="pg-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <label class="visually-hidden" for="pg-sample">Sample sprite</label>
    <select id="pg-sample" class="pg-sample">
      {samples.map((s) => <option value={s.name}>{s.name}.px</option>)}
    </select>
    <span class="pg-hint">edit me</span>
  </div>
  <div class="pg-body">
    <div class="pg-editor">
      <pre class="pg-paint" aria-hidden="true"><code></code></pre>
      <textarea class="pg-text" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="The .px source; edit it and the picture redraws">{first.text}</textarea>
    </div>
    <div class="pg-view">
      <div class="pg-stage checker"><canvas class="pg-canvas" width="96" height="40" role="img" aria-label="the sprite, drawn from the text"></canvas></div>
      <div class="pg-meta">
        <span class="pg-frame">—</span>
        <span class="pg-variants"></span>
      </div>
      <p class="pg-status" role="status"></p>
    </div>
  </div>
</div>

<style>
  .pg {
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--shadow);
    min-width: 0;
  }
  .pg-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.7rem;
    border-bottom: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
  }
  .pg-dots {
    display: flex;
    gap: 4px;
  }
  .pg-dots i {
    width: 10px;
    height: 10px;
    background: #c4473a;
  }
  .pg-dots i:nth-child(2) {
    background: #f3cf6b;
  }
  .pg-dots i:nth-child(3) {
    background: #4f8c6c;
  }
  .pg-sample {
    font: 500 0.85rem var(--font-mono);
    background: transparent;
    color: var(--paper);
    border: 1px solid color-mix(in srgb, var(--paper) 40%, transparent);
    padding: 0.1rem 0.3rem;
  }
  .pg-sample option {
    color: #2b1e2f;
    background: #efe6d2;
  }
  .pg-hint {
    margin-left: auto;
    font: 500 0.75rem var(--font-mono);
    opacity: 0.7;
  }
  .pg-body {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    min-height: 21rem;
  }
  .pg-editor {
    position: relative;
    border-right: 2px solid var(--ink);
    background: var(--paper-2);
    overflow: hidden;
    height: 24rem;
  }
  .pg-paint,
  .pg-text {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0.8rem 0.9rem;
    font: 400 0.8rem/1.45 var(--font-mono);
    letter-spacing: 0;
    white-space: pre;
    tab-size: 4;
    overflow: auto;
    border: 0;
  }
  .pg-paint {
    pointer-events: none;
    color: var(--ink);
    overflow: hidden;
  }
  .pg-paint code {
    font: inherit;
  }
  .pg-text {
    width: 100%;
    height: 100%;
    resize: none;
    background: transparent;
    color: transparent;
    caret-color: var(--ink);
    outline: none;
  }
  .pg-text::selection {
    background: color-mix(in srgb, var(--sea) 45%, transparent);
    color: transparent;
  }
  .pg-text:focus-visible {
    box-shadow: inset 0 0 0 3px var(--sea);
  }
  .pg-view {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pg-stage {
    height: 17rem;
    display: grid;
    place-items: center;
    padding: 1rem;
    overflow: hidden;
  }
  .pg-canvas {
    max-width: 100%;
    max-height: 100%;
  }
  .pg-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.7rem;
    border-top: 2px solid var(--ink);
    font: 500 0.78rem var(--font-mono);
    color: var(--ink-2);
  }
  .pg-variants {
    display: flex;
    gap: 0.3rem;
  }
  .pg-variants :global(button) {
    font: 500 0.75rem var(--font-mono);
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .pg-variants :global(button[aria-pressed="true"]) {
    background: var(--ink);
    color: var(--paper);
  }
  .pg-status {
    margin: 0;
    padding: 0.45rem 0.7rem;
    font: 400 0.75rem/1.4 var(--font-mono);
    color: var(--ink-2);
    border-top: 1px dashed var(--rule);
    min-height: 2.6rem;
  }
  .pg-status.bad {
    color: #a33a2f;
    background: color-mix(in srgb, #c4473a 12%, transparent);
  }
  :global(.pg-paint .pxc-px) {
    background: var(--c);
    color: var(--on);
  }
  :global(.pg-paint .pxc-bad) {
    background: repeating-linear-gradient(45deg, #c4473a 0 2px, transparent 2px 4px);
    color: var(--ink);
    outline: 1px solid #c4473a;
  }
  :global(.pg-paint .pxc-dot) {
    color: var(--muted);
    opacity: 0.6;
  }
  :global(.pg-paint .pxc-comment) {
    color: var(--muted);
    font-style: italic;
  }
  :global(.pg-paint .pxc-directive) {
    color: #a33a2f;
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .pg-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .pg-editor {
      border-right: 0;
      border-bottom: 2px solid var(--ink);
      height: 17rem;
    }
  }
</style>

<script>
  import { parsePx, parseColor, paletteFor, drawFrame, escapeHtml, type Rgba, type PxDoc } from "../lib/px";

  for (const root of document.querySelectorAll<HTMLElement>(".pg")) {
    const samples: { name: string; text: string }[] = JSON.parse(root.dataset.samples!);
    const text = root.querySelector<HTMLTextAreaElement>(".pg-text")!;
    const paint = root.querySelector<HTMLElement>(".pg-paint code")!;
    const paintPre = root.querySelector<HTMLElement>(".pg-paint")!;
    const canvas = root.querySelector<HTMLCanvasElement>(".pg-canvas")!;
    const stage = root.querySelector<HTMLElement>(".pg-stage")!;
    const frameLabel = root.querySelector<HTMLElement>(".pg-frame")!;
    const variantsEl = root.querySelector<HTMLElement>(".pg-variants")!;
    const status = root.querySelector<HTMLElement>(".pg-status")!;
    const select = root.querySelector<HTMLSelectElement>(".pg-sample")!;
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let doc: PxDoc = parsePx("");
    let variant = "";
    let frameIndex = 0;
    let timer = 0;

    const onColor = ([r, g, b]: Rgba) => (0.2126 * r + 0.7152 * g + 0.0722 * b > 140 ? "#2b1e2f" : "#efe6d2");

    function paintText(src: string, pal: Map<string, Rgba>) {
      let inGrid = false;
      paint.innerHTML =
        src
          .split("\n")
          .map((line) => {
            if (line.startsWith("#")) return `<span class="pxc-comment">${escapeHtml(line)}</span>`;
            if (line.startsWith("@") || /^pxart\s+\d+$/.test(line)) {
              inGrid = false;
              const [w, ...rest] = line.split(" ");
              return `<span class="pxc-directive">${escapeHtml(w)}</span>${rest.length ? " " + escapeHtml(rest.join(" ")) : ""}`;
            }
            const key = /^(\S)(\s+)(#[0-9a-fA-F]{6,8}|transparent)(.*)$/.exec(line);
            if (key && !inGrid) {
              const c = key[3];
              const rgba = parseColor(c.slice(0, c.length === 9 ? 9 : 7));
              const style = rgba && rgba[3] > 0 ? `--c:${c};--on:${onColor(rgba)}` : "--c:transparent;--on:var(--ink)";
              return `<span class="pxc-px" style="${style}">${escapeHtml(key[1])}</span>${key[2]}${escapeHtml(c)}${escapeHtml(key[4])}`;
            }
            if (/^\S+$/.test(line)) {
              inGrid = true;
              return [...line]
                .map((ch) => {
                  if (ch === ".") return `<span class="pxc-dot">.</span>`;
                  const c = pal.get(ch);
                  if (!c) return `<span class="pxc-bad">${escapeHtml(ch)}</span>`;
                  if (c[3] === 0) return `<span class="pxc-dot">${escapeHtml(ch)}</span>`;
                  return `<span class="pxc-px" style="--c:rgb(${c[0]} ${c[1]} ${c[2]} / ${(c[3] / 255).toFixed(2)});--on:${onColor(c)}">${escapeHtml(ch)}</span>`;
                })
                .join("");
            }
            if (!line.trim()) inGrid = false;
            return escapeHtml(line);
          })
          .join("\n") + "\n";
    }

    function problems(d: PxDoc): string[] {
      const out: string[] = [];
      if (d.unknown.size) out.push(`keys ${[...d.unknown].map((k) => `'${k}'`).join(", ")} aren't in the palette`);
      for (const f of d.frames) {
        const w = f.rows[0].length;
        const bad = f.rows.findIndex((r) => r.length !== w);
        if (bad >= 0) {
          out.push(`${f.id ? `frame ${f.id}, ` : ""}row ${bad} is ${f.rows[bad].length} wide; row 0 is ${w}`);
          break;
        }
      }
      return out;
    }

    function fitScale(): number {
      const f = doc.frames[0];
      if (!f) return 8;
      const w = Math.max(...doc.frames.map((fr) => Math.max(...fr.rows.map((r) => r.length))));
      const h = Math.max(...doc.frames.map((fr) => fr.rows.length));
      const box = stage.getBoundingClientRect();
      const avail = Math.max(64, Math.min(box.width - 32, 360));
      const availH = Math.max(120, Math.min(box.height - 32, 320));
      return Math.max(1, Math.min(16, Math.floor(Math.min(avail / w, availH / h))));
    }

    function drawCurrent() {
      const f = doc.frames[frameIndex % Math.max(1, doc.frames.length)];
      if (!f) {
        const ctx = canvas.getContext("2d")!;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        frameLabel.textContent = "no grid yet";
        return;
      }
      drawFrame(canvas, f, paletteFor(doc, variant), fitScale());
      const w = Math.max(...f.rows.map((r) => r.length));
      frameLabel.textContent = `${f.id || "frame"} · ${w}x${f.rows.length}${variant ? ` %${variant}` : ""}`;
    }

    function frameMs(i: number): number {
      const f = doc.frames[i];
      if (!f) return 200;
      if (f.ms) return f.ms;
      const group = f.id.split("/").slice(0, -1).join("/");
      return doc.anims.get(group)?.ms ?? 200;
    }

    function play() {
      clearTimeout(timer);
      drawCurrent();
      if (doc.frames.length < 2 || reduceMotion) return;
      timer = window.setTimeout(() => {
        frameIndex = (frameIndex + 1) % doc.frames.length;
        play();
      }, frameMs(frameIndex));
    }

    function renderVariants() {
      const names = ["", ...doc.variants.keys()];
      if (!names.includes(variant)) variant = "";
      variantsEl.innerHTML = names.length > 1 ? names.map((n) => `<button type="button" data-v="${escapeHtml(n)}" aria-pressed="${n === variant}">${n ? "%" + escapeHtml(n) : "base"}</button>`).join("") : "";
    }

    function update() {
      doc = parsePx(text.value);
      const pal = paletteFor(doc, variant);
      paintText(text.value, pal);
      renderVariants();
      const errs = problems(doc);
      status.classList.toggle("bad", errs.length > 0);
      const n = doc.frames.length;
      status.textContent = errs.length
        ? errs.join("; ")
        : n
          ? `${n} frame${n > 1 ? "s" : ""}, ${doc.palette.size} keys${doc.variants.size ? `, variants: ${[...doc.variants.keys()].join(", ")}` : ""}. For the real check: pxart check FILE`
          : "Add rows of keys under the palette.";
      if (frameIndex >= n) frameIndex = 0;
      play();
    }

    text.addEventListener("input", update);
    text.addEventListener("scroll", () => {
      paintPre.scrollTop = text.scrollTop;
      paintPre.scrollLeft = text.scrollLeft;
    });
    variantsEl.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (!b) return;
      variant = b.dataset.v ?? "";
      update();
    });
    select.addEventListener("change", () => {
      const s = samples.find((x) => x.name === select.value);
      if (!s) return;
      text.value = s.text;
      text.scrollTop = 0;
      variant = "";
      frameIndex = 0;
      update();
    });
    new ResizeObserver(() => drawCurrent()).observe(stage);
    update();
  }
</script>
